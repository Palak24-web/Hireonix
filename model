<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Hireonix – AI-Powered Hiring & Retention</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root {
    --navy: #0D1B3E;
    --blue: #1A4BDB;
    --blue-mid: #2A5EF5;
    --sky: #5B8EF0;
    --ice: #EBF1FF;
    --white: #FFFFFF;
    --slate: #4A5568;
    --muted: #8B9CB8;
    --border: #D8E3F5;
    --green: #22C55E;
    --amber: #F59E0B;
    --red: #EF4444;
  }

  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  html { scroll-behavior: smooth; }

  body {
    font-family: 'Inter', sans-serif;
    background: var(--white);
    color: var(--navy);
    line-height: 1.6;
    overflow-x: hidden;
  }

  /* NAV */
  nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 100;
    display: flex; align-items: center; justify-content: space-between;
    padding: 0 5%; height: 68px;
    background: rgba(255,255,255,0.92);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
  }

  .nav-logo {
    display: flex; align-items: center; gap: 10px;
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.4rem; font-weight: 700;
    color: var(--navy); text-decoration: none;
  }

  .nav-logo-icon {
    width: 36px; height: 36px; border-radius: 10px;
    background: var(--blue);
    display: flex; align-items: center; justify-content: center;
    color: white; font-size: 1rem; font-weight: 700;
  }

  .nav-links {
    display: flex; gap: 2rem; list-style: none;
  }

  .nav-links a {
    text-decoration: none; color: var(--slate); font-size: 0.9rem;
    font-weight: 500; transition: color 0.2s;
  }
  .nav-links a:hover { color: var(--blue); }

  .nav-cta {
    background: var(--blue); color: white;
    padding: 0.5rem 1.3rem; border-radius: 8px;
    font-size: 0.875rem; font-weight: 600;
    text-decoration: none; transition: background 0.2s;
  }
  .nav-cta:hover { background: var(--blue-mid); }

  /* HERO */
  .hero {
    min-height: 100vh;
    background: linear-gradient(145deg, var(--navy) 0%, #0F2565 55%, #1A3A8F 100%);
    display: flex; align-items: center;
    padding: 100px 5% 80px;
    position: relative; overflow: hidden;
  }

  .hero::before {
    content: '';
    position: absolute; top: -200px; right: -200px;
    width: 700px; height: 700px; border-radius: 50%;
    background: radial-gradient(circle, rgba(91,142,240,0.18) 0%, transparent 70%);
    pointer-events: none;
  }

  .hero::after {
    content: '';
    position: absolute; bottom: -100px; left: 20%;
    width: 400px; height: 400px; border-radius: 50%;
    background: radial-gradient(circle, rgba(26,75,219,0.2) 0%, transparent 70%);
    pointer-events: none;
  }

  .hero-inner {
    max-width: 1200px; margin: 0 auto; width: 100%;
    display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: center;
  }

  .hero-eyebrow {
    display: inline-flex; align-items: center; gap: 8px;
    background: rgba(91,142,240,0.18); border: 1px solid rgba(91,142,240,0.35);
    padding: 6px 14px; border-radius: 100px;
    font-size: 0.78rem; font-weight: 600; color: var(--sky);
    letter-spacing: 0.06em; text-transform: uppercase; margin-bottom: 1.5rem;
  }

  .hero-eyebrow span { width: 6px; height: 6px; border-radius: 50%; background: var(--sky); }

  .hero h1 {
    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(2.4rem, 4.5vw, 3.6rem);
    font-weight: 700; color: white; line-height: 1.15; margin-bottom: 1.2rem;
  }

  .hero h1 em { font-style: normal; color: var(--sky); }

  .hero p {
    font-size: 1.05rem; color: rgba(255,255,255,0.72);
    max-width: 480px; margin-bottom: 2rem;
  }

  .hero-buttons { display: flex; gap: 1rem; flex-wrap: wrap; }

  .btn-primary {
    background: var(--blue); color: white;
    padding: 0.85rem 2rem; border-radius: 10px;
    font-weight: 600; font-size: 0.95rem;
    text-decoration: none; transition: all 0.2s;
    border: none; cursor: pointer;
  }
  .btn-primary:hover { background: var(--blue-mid); transform: translateY(-1px); }

  .btn-outline {
    background: transparent; color: white;
    padding: 0.85rem 2rem; border-radius: 10px;
    font-weight: 600; font-size: 0.95rem;
    text-decoration: none; border: 1px solid rgba(255,255,255,0.3);
    transition: all 0.2s;
  }
  .btn-outline:hover { background: rgba(255,255,255,0.08); }

  /* HERO STATS */
  .hero-stats {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px;
    margin-top: 2.5rem;
    background: rgba(255,255,255,0.1); border-radius: 14px; overflow: hidden;
    border: 1px solid rgba(255,255,255,0.12);
  }

  .stat {
    padding: 1.2rem 1rem; text-align: center;
    background: rgba(255,255,255,0.04);
  }

  .stat-num {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.8rem; font-weight: 700; color: white; display: block;
  }

  .stat-label { font-size: 0.75rem; color: rgba(255,255,255,0.55); }

  /* DASHBOARD MOCKUP */
  .hero-visual { position: relative; }

  .dashboard-card {
    background: white; border-radius: 16px;
    padding: 20px; box-shadow: 0 40px 80px rgba(0,0,0,0.4);
    position: relative; z-index: 2;
  }

  .dash-header {
    display: flex; align-items: center; justify-content: space-between;
    margin-bottom: 16px;
  }

  .dash-title { font-weight: 700; font-size: 0.9rem; color: var(--navy); }
  .dash-badge { background: var(--ice); color: var(--blue); font-size: 0.7rem; font-weight: 600; padding: 3px 8px; border-radius: 6px; }

  .dash-metrics {
    display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; margin-bottom: 16px;
  }

  .metric {
    background: var(--ice); border-radius: 10px; padding: 12px 10px; text-align: center;
  }

  .metric-val {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.3rem; font-weight: 700; color: var(--blue); display: block;
  }

  .metric-lbl { font-size: 0.62rem; color: var(--muted); line-height: 1.3; margin-top: 2px; }

  .candidate-list { display: flex; flex-direction: column; gap: 8px; }

  .candidate-row {
    display: flex; align-items: center; gap: 10px;
    padding: 8px 10px; border-radius: 8px; background: #F8FAFF;
  }

  .cand-avatar {
    width: 28px; height: 28px; border-radius: 50%;
    background: var(--blue); display: flex; align-items: center; justify-content: center;
    color: white; font-size: 0.65rem; font-weight: 700; flex-shrink: 0;
  }

  .cand-name { font-size: 0.78rem; font-weight: 600; color: var(--navy); flex: 1; }
  .cand-match { font-size: 0.72rem; font-weight: 600; color: var(--blue); }
  .cand-status {
    font-size: 0.65rem; font-weight: 600; padding: 2px 7px; border-radius: 5px;
  }
  .status-shortlisted { background: #DCFCE7; color: #16A34A; }
  .status-tested { background: #FEF9C3; color: #92400E; }
  .status-rejected { background: #FEE2E2; color: #B91C1C; }

  .floating-badge {
    position: absolute; background: white;
    border-radius: 12px; padding: 10px 14px;
    box-shadow: 0 8px 24px rgba(0,0,0,0.15);
    font-size: 0.75rem; font-weight: 600; color: var(--navy);
    display: flex; align-items: center; gap: 8px;
    animation: float 3s ease-in-out infinite;
  }

  .badge-left { top: -24px; left: -30px; animation-delay: 0.5s; }
  .badge-right { bottom: 20px; right: -28px; }

  .badge-dot { width: 8px; height: 8px; border-radius: 50%; }

  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-6px); }
  }

  /* SECTIONS */
  section { padding: 90px 5%; }

  .section-inner { max-width: 1200px; margin: 0 auto; }

  .section-eyebrow {
    font-size: 0.75rem; font-weight: 700; letter-spacing: 0.1em;
    text-transform: uppercase; color: var(--blue); margin-bottom: 0.8rem;
  }

  .section-title {
    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(1.8rem, 3vw, 2.6rem);
    font-weight: 700; color: var(--navy); margin-bottom: 1rem; line-height: 1.2;
  }

  .section-subtitle {
    font-size: 1rem; color: var(--slate); max-width: 560px; margin-bottom: 3rem;
  }

  /* FEATURES */
  .features-bg { background: #F8FAFF; }

  .features-grid {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px;
  }

  .feature-card {
    background: white; border-radius: 16px; padding: 28px 24px;
    border: 1px solid var(--border);
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .feature-card:hover { transform: translateY(-4px); box-shadow: 0 20px 40px rgba(26,75,219,0.1); }

  .feature-card.featured {
    background: var(--navy); border-color: var(--navy);
    grid-column: span 2;
  }

  .feature-icon {
    width: 48px; height: 48px; border-radius: 12px;
    background: var(--ice); display: flex; align-items: center; justify-content: center;
    font-size: 1.4rem; margin-bottom: 16px;
  }

  .feature-card.featured .feature-icon { background: rgba(91,142,240,0.2); }

  .feature-card h3 {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.05rem; font-weight: 700; margin-bottom: 8px; color: var(--navy);
  }

  .feature-card.featured h3 { color: white; }

  .feature-card p { font-size: 0.875rem; color: var(--slate); line-height: 1.6; }
  .feature-card.featured p { color: rgba(255,255,255,0.65); }

  .feature-pill {
    display: inline-block; margin-top: 14px;
    background: var(--ice); color: var(--blue);
    font-size: 0.72rem; font-weight: 600;
    padding: 4px 10px; border-radius: 6px;
  }
  .feature-card.featured .feature-pill { background: rgba(91,142,240,0.2); color: var(--sky); }

  /* HOW IT WORKS */
  .steps {
    display: grid; grid-template-columns: repeat(4, 1fr); gap: 0;
    position: relative;
  }

  .steps::before {
    content: ''; position: absolute;
    top: 28px; left: 8%; right: 8%; height: 2px;
    background: var(--border); z-index: 0;
  }

  .step { text-align: center; padding: 0 16px; position: relative; z-index: 1; }

  .step-num {
    width: 56px; height: 56px; border-radius: 50%;
    background: var(--blue); color: white;
    display: flex; align-items: center; justify-content: center;
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.1rem; font-weight: 700;
    margin: 0 auto 20px; border: 3px solid white;
    box-shadow: 0 0 0 2px var(--border);
  }

  .step h4 {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 0.95rem; font-weight: 700; margin-bottom: 8px; color: var(--navy);
  }

  .step p { font-size: 0.82rem; color: var(--slate); }

  /* MARKET */
  .market-grid {
    display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: center;
  }

  .market-bg { background: var(--navy); color: white; }
  .market-bg .section-title { color: white; }
  .market-bg .section-subtitle { color: rgba(255,255,255,0.65); }

  .market-cards { display: flex; flex-direction: column; gap: 16px; }

  .market-card {
    background: rgba(255,255,255,0.07);
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 14px; padding: 20px;
    display: flex; gap: 16px; align-items: flex-start;
  }

  .market-card-icon {
    font-size: 1.5rem; flex-shrink: 0;
    width: 44px; height: 44px; border-radius: 10px;
    background: rgba(91,142,240,0.2);
    display: flex; align-items: center; justify-content: center;
  }

  .market-card h4 {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 0.9rem; font-weight: 700; color: white; margin-bottom: 4px;
  }
  .market-card p { font-size: 0.8rem; color: rgba(255,255,255,0.6); }

  .big-number {
    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(3.5rem, 7vw, 6rem); font-weight: 700;
    color: white; line-height: 1;
  }

  .big-number span { color: var(--sky); }

  /* SWOT */
  .swot-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; }

  .swot-card { border-radius: 16px; padding: 24px; }
  .swot-s { background: #EFF6FF; border: 1px solid #BFDBFE; }
  .swot-w { background: #FFF7ED; border: 1px solid #FED7AA; }
  .swot-o { background: #F0FDF4; border: 1px solid #BBF7D0; }
  .swot-t { background: #FFF1F2; border: 1px solid #FECDD3; }

  .swot-header {
    display: flex; align-items: center; gap: 10px; margin-bottom: 14px;
  }

  .swot-letter {
    width: 36px; height: 36px; border-radius: 10px;
    display: flex; align-items: center; justify-content: center;
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.1rem; font-weight: 700; color: white;
  }

  .swot-s .swot-letter { background: #2563EB; }
  .swot-w .swot-letter { background: #D97706; }
  .swot-o .swot-letter { background: #16A34A; }
  .swot-t .swot-letter { background: #DC2626; }

  .swot-card h4 {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 0.95rem; font-weight: 700;
  }

  .swot-s h4 { color: #1E40AF; }
  .swot-w h4 { color: #92400E; }
  .swot-o h4 { color: #15803D; }
  .swot-t h4 { color: #991B1B; }

  .swot-list { list-style: none; }
  .swot-list li {
    font-size: 0.82rem; color: var(--slate); padding: 4px 0;
    display: flex; gap: 8px; align-items: flex-start;
  }
  .swot-list li::before { content: '→'; font-size: 0.75rem; flex-shrink: 0; margin-top: 2px; }

  /* TEAM */
  .team-bg { background: #F8FAFF; }

  .team-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }

  .team-card {
    text-align: center; background: white; border-radius: 16px;
    padding: 24px 16px; border: 1px solid var(--border);
    transition: transform 0.2s;
  }
  .team-card:hover { transform: translateY(-3px); }

  .team-avatar {
    width: 64px; height: 64px; border-radius: 50%;
    background: linear-gradient(135deg, var(--blue), var(--sky));
    display: flex; align-items: center; justify-content: center;
    color: white; font-family: 'Space Grotesk', sans-serif;
    font-size: 1.3rem; font-weight: 700; margin: 0 auto 14px;
  }

  .team-card h4 {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 0.9rem; font-weight: 700; color: var(--navy); margin-bottom: 6px;
  }
  .team-card p { font-size: 0.75rem; color: var(--muted); }

  /* PRICING */
  .pricing-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }

  .pricing-card {
    border-radius: 16px; padding: 32px 24px;
    border: 1px solid var(--border); background: white;
    transition: transform 0.2s;
  }
  .pricing-card:hover { transform: translateY(-4px); }
  .pricing-card.featured-plan { background: var(--navy); border-color: var(--navy); }

  .pricing-badge {
    display: inline-block; margin-bottom: 12px;
    font-size: 0.7rem; font-weight: 700; letter-spacing: 0.08em;
    text-transform: uppercase; padding: 4px 10px; border-radius: 6px;
    background: var(--ice); color: var(--blue);
  }
  .featured-plan .pricing-badge { background: rgba(91,142,240,0.2); color: var(--sky); }

  .pricing-card h3 {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.1rem; font-weight: 700; color: var(--navy); margin-bottom: 8px;
  }
  .featured-plan h3 { color: white; }

  .pricing-price {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 2.4rem; font-weight: 700; color: var(--blue); margin: 16px 0;
  }
  .featured-plan .pricing-price { color: white; }
  .pricing-price small { font-size: 0.9rem; color: var(--muted); font-weight: 400; }

  .pricing-features { list-style: none; margin: 20px 0; }
  .pricing-features li {
    font-size: 0.85rem; color: var(--slate); padding: 6px 0;
    display: flex; gap: 8px; align-items: center;
    border-bottom: 1px solid var(--border);
  }
  .featured-plan .pricing-features li { color: rgba(255,255,255,0.75); border-color: rgba(255,255,255,0.1); }
  .pricing-features li::before { content: '✓'; color: var(--green); font-weight: 700; }

  .pricing-btn {
    display: block; text-align: center;
    padding: 0.8rem; border-radius: 10px;
    font-weight: 600; font-size: 0.9rem; text-decoration: none;
    transition: all 0.2s; margin-top: 20px;
  }
  .pricing-btn-outline {
    border: 1px solid var(--border); color: var(--navy);
  }
  .pricing-btn-outline:hover { background: var(--ice); }

  .pricing-btn-filled {
    background: var(--blue); color: white; border: none;
  }
  .pricing-btn-filled:hover { background: var(--blue-mid); }

  /* CTA BANNER */
  .cta-section {
    background: linear-gradient(135deg, var(--blue) 0%, #0D1B3E 100%);
    text-align: center; padding: 80px 5%;
  }

  .cta-section h2 {
    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(1.8rem, 3.5vw, 3rem);
    font-weight: 700; color: white; margin-bottom: 1rem;
  }

  .cta-section p { color: rgba(255,255,255,0.7); font-size: 1rem; margin-bottom: 2rem; }

  /* FOOTER */
  footer {
    background: var(--navy); color: rgba(255,255,255,0.5);
    padding: 40px 5%; text-align: center; font-size: 0.82rem;
  }

  footer strong { color: white; }

  /* RESPONSIVE */
  @media (max-width: 900px) {
    .hero-inner { grid-template-columns: 1fr; }
    .hero-visual { display: none; }
    .features-grid { grid-template-columns: 1fr; }
    .feature-card.featured { grid-column: span 1; }
    .steps { grid-template-columns: repeat(2, 1fr); gap: 32px; }
    .steps::before { display: none; }
    .market-grid { grid-template-columns: 1fr; }
    .swot-grid { grid-template-columns: 1fr; }
    .team-grid { grid-template-columns: repeat(3, 1fr); }
    .pricing-grid { grid-template-columns: 1fr; }
    .nav-links { display: none; }
  }

  @media (max-width: 600px) {
    .dash-metrics { grid-template-columns: repeat(2, 1fr); }
    .team-grid { grid-template-columns: repeat(2, 1fr); }
  }
</style>
</head>
